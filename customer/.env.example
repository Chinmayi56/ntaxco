# Customer frontend build-time setting (React Scripts/CRACO app).
# Add the Google OAuth 2.0 Web Client ID here for local development.
# In Vercel, set the same variable in the CUSTOMER project settings and redeploy.
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# API URL for the deployed FastAPI backend, if this customer app uses a separate backend origin.
REACT_APP_API_URL=https://your-backend-host.example.com/api
