```gitignore
# Node.js dependencies
node_modules/
**/node_modules/

# Build and cache files
.cache/
**/.cache/
build/
**/build/
dist/
**/dist/
coverage/
**/coverage/

# Python virtual environments
venv/
.venv/
**/venv/
**/.venv/

# Python cache files
__pycache__/
**/__pycache__/
*.py[cod]

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
